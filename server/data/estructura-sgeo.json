  "modeloCCPS": {
    "nombre": "CCPS RBPS — Pilares y Elementos de la Seguridad de Procesos (PSM)",
    "pilares": [
      {
        "nro": 1,
        "titulo": "Compromiso con la seguridad de procesos",
        "descripcion": "Compromiso de la dirección. Las organizaciones mejoran con un fuerte liderazgo y sólido compromiso. Toda la organización debe estar alineada.",
        "elementos": [
          {
            "id": "1.1",
            "titulo": "Cultura de seguridad de procesos",
            "descripcion": "Fomentar una actitud colectiva e individual de prioridad de la seguridad."
          },
          {
            "id": "1.2",
            "titulo": "Cumplimiento de los estándares",
            "descripcion": "Seguir de forma rigurosa las normativas, códigos y leyes vigentes."
          },
          {
            "id": "1.3",
            "titulo": "Competencia en seguridad de procesos",
            "descripcion": "Desarrollar y mantener los conocimientos técnicos pertinentes de todo el personal."
          },
          {
            "id": "1.4",
            "titulo": "Participación de la fuerza de trabajo",
            "descripcion": "Involucrar activamente a los trabajadores en las decisiones y comités de seguridad."
          },
          {
            "id": "1.5",
            "titulo": "Alcance a las partes interesadas",
            "descripcion": "Mantener una comunicación transparente con la comunidad y entes externos."
          }
        ]
      },
      {
        "nro": 2,
        "titulo": "Entendimiento de los peligros y riesgos",
        "descripcion": "Las organizaciones que entienden los peligros y riesgos están mejor capacitadas para asignar recursos limitados de la manera más eficaz.",
        "elementos": [
          {
            "id": "2.1",
            "titulo": "Gestión del conocimiento del proceso",
            "descripcion": "Recopilar y mantener actualizada toda la documentación técnica de las instalaciones."
          },
          {
            "id": "2.2",
            "titulo": "Identificación de peligros y análisis de riesgos",
            "descripcion": "Evaluar de forma sistemática los escenarios de fallas potenciales."
          }
        ]
      },
      {
        "nro": 3,
        "titulo": "Gestión de Riesgos",
        "descripcion": "Foco en: Disciplina operativa - Gestión del cambio - Preparación y respuesta a la emergencia",
        "elementos": [
          {
            "id": "3.1",
            "titulo": "Procedimientos operativos",
            "descripcion": "Mantener instrucciones de trabajo claras para operar de forma segura"
          },
          {
            "id": "3.2",
            "titulo": "Prácticas de trabajo seguro",
            "descripcion": "Controlar actividades críticas que no forman parte de la rutina."
          },
          {
            "id": "3.3",
            "titulo": "Integridad y confiabilidad de activos",
            "descripcion": "Asegurar que los equipos críticos funcionen correctamente mediante mantenimiento inspección y pruebas."
          },
          {
            "id": "3.4",
            "titulo": "Gestión de contratistas",
            "descripcion": "Garantizar que el personal externo cumpla con los mismos estándares de seguridad de la organización."
          },
          {
            "id": "3.5",
            "titulo": "Capacitación y desempeño",
            "descripcion": "Entrenar al personal operativo y verificar que aplican los conocimientos de seguridad en sus actvidades diarias."
          },
          {
            "id": "3.6",
            "titulo": "Gestión del cambio",
            "descripcion": "Evaluar y autorizar cualquier modificación física, de personas o de proceso previo a su ejecución."
          },
          {
            "id": "3.7",
            "titulo": "Preparación operacional (previa al arranque)",
            "descripcion": "Confirmar que una instalación nueva o modificada cumple con todos los requisitos técnicos previo a su puesta en marcha."
          },
          {
            "id": "3.8",
            "titulo": "Conducir las operaciones",
            "descripcion": "Ejecutar las tareas diarias dentro de los límites de diseño de los activos."
          },
          {
            "id": "3.9",
            "titulo": "Gestión de emergencias",
            "descripcion": "Planificar y realizar simulacros de respuesta ante siniestros o pérdidas de contención químicas."
          }
        ]
      },
      {
        "nro": 4,
        "titulo": "Aprender de la experiencia",
        "descripcion": "Implica el monitoreo y la actuación en base a las fuentes internas y externas de información, corregir incidentes y accidentes, y aplicar lecciones aprendidas.",
        "elementos": [
          {
            "id": "4.1",
            "titulo": "Investigación de incidentes",
            "descripcion": "Determinar las causas raíz de accidentes, incidentes y cuasiaccidentes para evitar su repetición."
          },
          {
            "id": "4.2",
            "titulo": "Mediciones y métricas",
            "descripcion": "Utilizar indicadores clave de desempeño preventivos y reactivos para evaluar el estado del sistema."
          },
          {
            "id": "4.3",
            "titulo": "Auditorías (verificación)",
            "descripcion": "Realizar revisiones periódicas e independientes sobre la eficacia de los elementos implementados."
          },
          {
            "id": "4.4",
            "titulo": "Mejora continua",
            "descripcion": "Evaluar periódicamente los resultados del sistema por parte de la alta gerencia para optimizarlo."
          }
        ]
      }
    ]
  }
}